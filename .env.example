# FitLens AI Environment Variables

# App
NEXT_PUBLIC_APP_NAME="FitLens AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL / Supabase / Neon / Azure Database for PostgreSQL)
DATABASE_URL="postgresql://fitlens_user:secure_password_123@localhost:5432/fitlens_ai?schema=public"

# AI Vision Providers (Configured for multi-model fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Cloud Storage (Azure Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="food-uploads"

# Auth Secrets
NEXTAUTH_SECRET="fitlens-ai-ultra-secure-jwt-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# External Nutrition APIs
USDA_API_KEY=""
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org/api/v2"

# Fitness Sync Webhooks
APPLE_HEALTH_KIT_ENABLED=true
GOOGLE_FIT_CLIENT_ID=""
FITBIT_CLIENT_ID=""
GARMIN_CONSUMER_KEY=""
